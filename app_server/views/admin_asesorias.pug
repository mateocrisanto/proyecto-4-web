extends layout

block content
  .container-fluid.py-4.admin-asesorias-page
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0
        i.fas.fa-comments.me-2(style='color:var(--c-pink)')
        | Solicitudes de Asesoría
      a.btn.btn-outline-secondary.btn-sm(href='/' style='border-radius:50px')
        i.fas.fa-home.me-1
        | Inicio

    #admin-asesorias-react-root
    script(type='application/json' id='admin-asesorias-initial-data').
      !{JSON.stringify({ asesorias: asesorias || [], error: error || null }).replace(/<\//g, '<\\/')}

block scripts
  if viteDevUrl
    script(type='module' src=`${viteDevUrl}/src/entries/admin-asesorias.jsx`)
  else
    script(type='module' src='/vite/adminAsesorias.js')
