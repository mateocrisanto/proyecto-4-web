extends layout

block content
  .container-fluid.py-4
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0
        i.fas.fa-comments.me-2(style='color:var(--c-pink)')
        | Solicitudes de Asesoría
      a.btn.btn-outline-secondary.btn-sm(href='/' style='border-radius:50px')
        i.fas.fa-home.me-1
        | Inicio

    if error
      .alert.mb-3(style='background:rgba(244,145,191,0.12);border:1px solid rgba(244,145,191,0.4);color:#F491BF;border-radius:.75rem')
        = error

    if asesorias && asesorias.length > 0
      p.text-muted.mb-3
        i.fas.fa-inbox.me-1
        |  #{asesorias.length} solicitud(es) — selecciona una para ver el chat

      //- Layout de dos columnas: lista de solicitudes | panel de chat
      .row.g-0(style='height:78vh')

        //- ── Columna izquierda: lista de solicitudes ──────────────────────
        .col-md-4.border-end(style='overflow-y:auto;border-color:rgba(211,116,255,0.2) !important')
          each a in asesorias
            .asesoria-item.p-3.border-bottom(
              id=`item-${a._id}`
              data-id=`${a._id}`
              style='cursor:pointer;border-color:rgba(211,116,255,0.1) !important;transition:background .2s'
              onclick=`openChat('${a._id}')`
            )
              .d-flex.justify-content-between.align-items-start.mb-1
                span.fw-bold(style='color:var(--c-pink);font-size:.95rem')
                  i.fas.fa-user-circle.me-1
                  = a.nombre
                small.text-muted(style='font-size:.75rem')
                  = new Date(a.creado).toLocaleDateString('es-EC', {day:'2-digit',month:'short'})
              //- Badge/etiqueta del servicio seleccionado
              span.badge.mb-2(style='background:linear-gradient(90deg,rgba(100,220,255,.15),rgba(211,116,255,.15));border:1px solid rgba(211,116,255,.35);color:var(--c-purple);font-size:.7rem;font-weight:500')
                i.fas.fa-tag.me-1
                = a.servicio || 'Otra consulta'
              p.mb-2.text-muted(style='font-size:.82rem;line-height:1.3')= a.consulta.length > 80 ? a.consulta.slice(0,80) + '…' : a.consulta
              .d-flex.gap-2
                span.badge.rounded-pill(style='background:rgba(244,145,191,.08);color:#a0a0b8;font-size:.7rem')
                  i.fas.fa-comment-dots.me-1
                  = (a.mensajes ? a.mensajes.length : 0) + ' mens.'

        //- ── Columna derecha: panel de chat ───────────────────────────────
        .col-md-8.d-flex.flex-column#chat-panel
          //- Estado vacío (antes de seleccionar una solicitud)
          #chat-empty.d-flex.flex-column.align-items-center.justify-content-center.h-100.text-muted(style='gap:1rem')
            i.fas.fa-comments(style='font-size:3rem;color:rgba(211,116,255,.3)')
            p Selecciona una solicitud para iniciar el chat

          //- Panel de chat activo (oculto hasta que se seleccione)
          #chat-active.d-none.flex-column.h-100

            //- Encabezado del chat
            #chat-header.p-3.border-bottom(style='border-color:rgba(211,116,255,0.2) !important;flex-shrink:0')
              .d-flex.justify-content-between.align-items-center
                div
                  span.fw-bold#chat-nombre(style='color:var(--c-cyan)')
                  span.ms-2.badge#chat-servicio-badge(style='background:linear-gradient(90deg,rgba(100,220,255,.15),rgba(211,116,255,.15));border:1px solid rgba(211,116,255,.35);color:var(--c-purple);font-size:.75rem')
                form#form-delete(method='POST')
                  button.btn.btn-sm.btn-outline-danger(type='submit' onclick='return confirm("¿Eliminar esta solicitud?")')
                    i.fas.fa-trash.me-1
                    | Eliminar
              p.mt-1.mb-0.text-muted#chat-consulta(style='font-size:.85rem')

            //- Área de mensajes (scrollable)
            #chat-messages.flex-grow-1.p-3(style='overflow-y:auto;display:flex;flex-direction:column;gap:.75rem')

            //- Input para nuevo mensaje admin
            form#form-mensaje.p-3.border-top(style='border-color:rgba(211,116,255,0.2) !important;flex-shrink:0' method='POST')
              .input-group
                input.form-control#msg-input(
                  name='texto'
                  placeholder='Escribe tu respuesta...'
                  autocomplete='off'
                  required
                  style='border-color:rgba(211,116,255,.3);background:#12122a;color:#e8e8f0'
                )
                button.btn(type='submit' style='background:linear-gradient(90deg,var(--c-purple),var(--c-pink));color:#0d0d14;font-weight:600')
                  i.fas.fa-paper-plane

    else
      .alert.text-center(style='background:rgba(244,145,191,0.05);border:1px solid rgba(244,145,191,0.15);color:#a0a0b8')
        i.fas.fa-inbox.me-2
        | No hay solicitudes de asesoría por ahora.

  script.
    //- Datos de todas las asesorías inyectados desde el servidor
    const ASESORIAS = !{JSON.stringify(asesorias || [])};

    let currentId = null;

    function openChat(id) {
      const a = ASESORIAS.find(x => x._id === id);
      if (!a) return;
      currentId = id;

      // Resaltar ítem activo en la lista
      document.querySelectorAll('.asesoria-item').forEach(el => {
        el.style.background = '';
      });
      const active = document.getElementById('item-' + id);
      if (active) active.style.background = 'rgba(211,116,255,0.08)';

      // Llenar cabecera
      document.getElementById('chat-nombre').textContent = a.nombre;
      document.getElementById('chat-servicio-badge').textContent = a.servicio || 'Otra consulta';
      document.getElementById('chat-consulta').textContent = a.consulta;
      document.getElementById('form-delete').action = '/admin/asesorias/delete/' + id;
      document.getElementById('form-mensaje').action = '/admin/asesorias/' + id + '/mensaje';

      // Renderizar mensajes
      renderMessages(a.mensajes || []);

      // Mostrar panel de chat
      document.getElementById('chat-empty').classList.add('d-none');
      const chatActive = document.getElementById('chat-active');
      chatActive.classList.remove('d-none');
      chatActive.classList.add('d-flex');
    }

    function renderMessages(mensajes) {
      const container = document.getElementById('chat-messages');
      container.innerHTML = '';

      if (!mensajes || mensajes.length === 0) {
        container.innerHTML = '<p class="text-center text-muted" style="margin:auto;font-size:.85rem">Sin mensajes aún — sé el primero en responder.</p>';
        return;
      }

      mensajes.forEach(m => {
        const isAdmin = m.autor === 'admin';
        const wrap = document.createElement('div');
        wrap.className = 'd-flex ' + (isAdmin ? 'justify-content-end' : 'justify-content-start');

        const bubble = document.createElement('div');
        bubble.style.cssText = [
          'max-width:70%',
          'padding:.5rem .85rem',
          'border-radius:1rem',
          isAdmin
            ? 'background:linear-gradient(135deg,rgba(211,116,255,.25),rgba(244,145,191,.2));border-bottom-right-radius:.2rem'
            : 'background:rgba(100,220,255,.1);border:1px solid rgba(100,220,255,.2);border-bottom-left-radius:.2rem'
        ].join(';');

        const label = document.createElement('small');
        label.style.cssText = 'display:block;font-size:.7rem;margin-bottom:.2rem;color:' + (isAdmin ? 'var(--c-purple)' : 'var(--c-cyan)');
        label.textContent = isAdmin ? 'Admin' : 'Cliente';

        const text = document.createElement('p');
        text.style.cssText = 'margin:0;font-size:.88rem;color:#e8e8f0;word-break:break-word';
        text.textContent = m.texto;

        const ts = document.createElement('small');
        ts.style.cssText = 'display:block;font-size:.68rem;text-align:right;color:#6a6a8a;margin-top:.2rem';
        ts.textContent = m.enviado ? new Date(m.enviado).toLocaleTimeString('es-EC', {hour:'2-digit',minute:'2-digit'}) : '';

        bubble.appendChild(label);
        bubble.appendChild(text);
        bubble.appendChild(ts);
        wrap.appendChild(bubble);
        container.appendChild(wrap);
      });

      // Scroll al fondo
      container.scrollTop = container.scrollHeight;
    }
