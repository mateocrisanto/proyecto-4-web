extends layout

block content
  .container.py-5
    .row
      .col-12
        h1.display-4.text-center.mb-5 #{title}

    if cart && cart.items && cart.items.length > 0
      .row
        .col-lg-8
          .card.shadow
            .card-header
              h4.mb-0 Items en tu carrito
            .card-body
              each item in cart.items
                .row.mb-4.align-items-center.cart-item-row.gy-2
                  .col-4.col-md-2
                    img.img-fluid.rounded(src=item.imagen, alt=item.nombre, onerror="this.src='/images/placeholder.png'")
                  .col-8.col-md-4
                    h5= item.nombre
                    p.text-muted $#{(item.precio).toFixed(2)} c/u
                  .col-7.col-md-3
                    .input-group
                      button.btn.btn-outline-secondary.btn-sm(type='button', onclick=`updateQuantity('${item.productId}', ${item.cantidad - 1})`) -
                      input.form-control.text-center(type='number', value=item.cantidad, min='1', onchange=`updateQuantity('${item.productId}', this.value)`)
                      button.btn.btn-outline-secondary.btn-sm(type='button', onclick=`updateQuantity('${item.productId}', ${item.cantidad + 1})`) +
                  .col-3.col-md-2.text-end
                    strong $#{(item.precio * item.cantidad).toFixed(2)}
                  .col-2.col-md-1.text-end
                    button.btn.btn-outline-danger.btn-sm(type='button', onclick=`removeItem('${item.productId}')`)
                      i.fas.fa-trash

        .col-lg-4
          .card.shadow
            .card-header
              h4.mb-0 Resumen del pedido
            .card-body
              .d-flex.justify-content-between.mb-3
                strong Subtotal:
                span $#{(cart.total).toFixed(2)}
              .d-flex.justify-content-between.mb-3
                strong IVA (15%):
                span $#{(cart.total * 0.15).toFixed(2)}
              hr
              .d-flex.justify-content-between.mb-4
                strong.h5 Total:
                span.h5 $#{ (cart.total * 1.15).toFixed(2) }
              if paypalClientId
                #paypal-button-container.mb-3
              else
                .alert.alert-warning.small.mb-3
                  | PayPal no esta configurado todavia en este entorno. Agrega un Client ID sandbox valido para habilitar el pago.
              button.btn.btn-outline-secondary.btn-lg.w-100.mt-2(type='button', onclick='clearCart()') Vaciar carrito
    else
      .row
        .col-12.text-center
          .empty-cart.py-5
            i.fas.fa-shopping-cart.fa-4x.text-muted.mb-4
            h3 Carrito vacío
            p.text-muted No has añadido productos a tu carrito aún.
            a.btn.btn-primary.btn-lg(href='/products') Explorar productos

  script.
    let sessionId = '#{sessionId}';

    function updateQuantity(productId, newQuantity) {
      if (newQuantity < 1) return;

      fetch('/cart/update', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId, productId, cantidad: parseInt(newQuantity) })
      })
      .then(r => r.json())
      .then(data => { if (data._id) location.reload(); else alert('Error al actualizar cantidad'); })
      .catch(() => alert('Error de conexión'));
    }

    function removeItem(productId) {
      if (!confirm('¿Eliminar este producto del carrito?')) return;
      fetch('/cart/remove', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId, productId })
      })
      .then(r => r.json())
      .then(data => { if (data._id) location.reload(); else alert('Error al eliminar producto'); })
      .catch(() => alert('Error de conexión'));
    }

    function clearCart() {
      if (!confirm('¿Vaciar el carrito?')) return;
      fetch('/cart/clear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId })
      })
      .then(r => r.json())
      .then(data => { if (data._id) location.reload(); else alert('Error al vaciar carrito'); })
      .catch(() => alert('Error de conexión'));
    }

block scripts
  if paypalClientId && cart && cart.items && cart.items.length > 0
    script(src=`https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=USD`)
    script.
      paypal.Buttons({
        style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'pay' },
        createOrder: function() {
          return fetch('/pago/crear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.error) { alert('Error: ' + data.error); return; }
            return data.orderID;
          });
        },
        onApprove: function(data) {
          return fetch('/pago/capturar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderID: data.orderID })
          })
          .then(function(res) { return res.json(); })
          .then(function(result) {
            if (result.success) {
              window.location.href = '/pago/exito';
            } else {
              alert('Error al procesar el pago. Intenta nuevamente.');
            }
          });
        },
        onError: function(err) {
          console.error('PayPal error:', err);
          alert('Ocurrió un error con PayPal. Intenta nuevamente.');
        }
      }).render('#paypal-button-container');
