extends layout

block content
  .container.py-5
    .row
      .col-12
        h1.display-4.text-center.mb-5 #{title}
    #cart-react-root
    script(type='application/json' id='cart-initial-data').
      !{JSON.stringify({ cart: cart || { items: [], total: 0 }, sessionId: sessionId || '', paypalClientId: paypalClientId || null }).replace(/<\//g, '<\\/')}

block scripts
  if paypalClientId
    script(src=`https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=USD`)
  script(src='https://unpkg.com/react@18/umd/react.production.min.js')
  script(src='https://unpkg.com/react-dom@18/umd/react-dom.production.min.js')
  script(type='module' src='/javascripts/react-cart.js')
