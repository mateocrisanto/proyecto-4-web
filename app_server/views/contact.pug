extends layout

block content
  .container.py-5
    .row
      .col-lg-8.mx-auto
        h1.mb-4 #{title}
        #contact-react-root
        script(type='application/json' id='contact-initial-data').
          !{JSON.stringify({ title: title || '', servicios: servicios || [], miAsesoria: miAsesoria || null, userId: (sessionUser && sessionUser._id) ? sessionUser._id : null }).replace(/<\//g, '<\\/')}

block scripts
  if viteDevUrl
    script(type='module' src=`${viteDevUrl}/src/entries/contact.jsx`)
  else
    script(type='module' src='/vite/contact.js')
