extends layout

block content
  .container.py-5
    .row
      .col-lg-8.mx-auto
        h1.mb-4 #{title}
        #contact-react-root
        script(type='application/json' id='contact-initial-data').
          !{JSON.stringify({ title: title || '', servicios: servicios || [], miAsesoria: miAsesoria || null, userId: (sessionUser && sessionUser._id) ? sessionUser._id : null }).replace(/<\//g, '<\\/')}

block scripts
  script(src='https://unpkg.com/react@18/umd/react.production.min.js')
  script(src='https://unpkg.com/react-dom@18/umd/react-dom.production.min.js')
  script(type='module' src='/javascripts/react-contact.js')
