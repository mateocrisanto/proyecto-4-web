extends layout

block content
  // Hero Section con Medidor de Velocidad
  .hero-section.bg-primary.text-white
    .container
      .row.align-items-center
        .col-lg-4
          h1.hero-title.fw-bold #{title}
          p.hero-subtitle.mb-4 #{subtitle}
    img.hero-image(src='/images/gamer.png', alt='Medidor de velocidad', onerror="this.src='/images/placeholder.png'")
  
  // Sección Medidor de Velocidad
  .py-5
    .container
      .row
        .col-lg-8.offset-lg-2
          .speed-test-card#speed-test-card.p-5.rounded
            h3.mb-4.text-center Medidor de Velocidad de Internet
            
            // Download Speed
            .speed-result-item
              .speed-result-label
                span Download
                span.speed-result-value#download-speed --
                span.speed-result-unit Mbps
              .progress.speed-progress
                .progress-bar.progress-bar-azure#download-progress-bar(role='progressbar', style='width: 0%', aria-valuenow='0', aria-valuemin='0', aria-valuemax='100')
            
            // Upload Speed
            .speed-result-item
              .speed-result-label
                span Upload
                span.speed-result-value#upload-speed --
                span.speed-result-unit Mbps
              .progress.speed-progress
                .progress-bar.progress-bar-gray#upload-progress-bar(role='progressbar', style='width: 0%', aria-valuenow='0', aria-valuemin='0', aria-valuemax='100')
            
            // Ping
            .speed-result-item.mb-0
              .speed-result-label
                span Ping
                span.speed-result-value#ping --
                span.speed-result-unit ms
              .progress.speed-progress
                .progress-bar.progress-bar-white#ping-progress-bar(role='progressbar', style='width: 0%', aria-valuenow='0', aria-valuemin='0', aria-valuemax='100')
            
            .text-center.mt-4
              button.btn.btn-primary.btn-lg#start-speed-test Iniciar Prueba de Velocidad

  // Sección de Servicios Principales
  .services-section.py-5
    .container
      .row
        .col-12.text-center.mb-5
          h2.display-5 Nuestros Servicios Principales
          p.lead Elige el plan que mejor se adapte a tus necesidades

      .row.g-4
        .col-lg-3.col-md-6
          .card.h-100.shadow-sm
            .card-body.text-center
              h5.card-title.mb-3 Internet
              each plan in mainInternetPlans
                .mb-2
                  span.badge.bg-primary #{plan}
              a.btn.btn-outline-primary.btn-sm.mt-3(href='/servicios') Ver todos los planes

        .col-lg-3.col-md-6
          .card.h-100.shadow-sm
            .card-body.text-center
              h5.card-title.mb-3 Telefonía
              each plan in mainPhonePlans
                .mb-2
                  span.badge.bg-success #{plan}
              a.btn.btn-outline-success.btn-sm.mt-3(href='/servicios') Ver más

        .col-lg-3.col-md-6
          .card.h-100.shadow-sm
            .card-body.text-center
              h5.card-title.mb-3 Planes Celulares
              each plan in mainMobilePlans
                .mb-2
                  span.badge.bg-info #{plan}
              a.btn.btn-outline-info.btn-sm.mt-3(href='/servicios') Ver detalles

        .col-lg-3.col-md-6
          .card.h-100.shadow-sm
            .card-body.text-center
              h5.card-title.mb-3 TV
              each channel in mainChannels
                .mb-2
                  span.badge.bg-warning #{channel}
              a.btn.btn-outline-warning.btn-sm.mt-3(href='/servicios') Ver canales

  // Sección de Productos Destacados
  if featuredProducts && featuredProducts.length > 0
    .products-section.py-5
      .container
        .row
          .col-12.text-center.mb-5
            h2.display-5 Productos Destacados
            p.lead Explora nuestra selección de productos tecnológicos

        #featuredProductsCarousel.carousel.slide.products-carousel(data-bs-ride='carousel')
          .carousel-indicators
            each product, index in featuredProducts
              button(
                type='button',
                data-bs-target='#featuredProductsCarousel',
                data-bs-slide-to=index,
                class=index === 0 ? 'active' : '',
                aria-current=index === 0 ? 'true' : 'false',
                aria-label=`Producto ${index + 1}`
              )

          .carousel-inner
            each product, index in featuredProducts
              .carousel-item(class=index === 0 ? 'active' : '')
                .row.justify-content-center
                  .col-lg-8.col-md-10
                    .card.shadow-sm.product-card.product-carousel-card
                      .row.g-0.h-100
                        .col-md-5
                          img.card-img-top.product-carousel-image(
                            src=product.imagen,
                            alt=product.nombre,
                            onerror="this.src='/images/placeholder.png'"
                          )
                        .col-md-7
                          .card-body.d-flex.flex-column.h-100
                            span.badge.bg-primary-subtle.text-primary-emphasis.mb-3.align-self-start= product.categoria || 'Producto destacado'
                            h5.card-title= product.nombre
                            p.card-text.flex-grow-1= product.descripcion
                            .d-flex.justify-content-between.align-items-center.mb-3.product-carousel-meta
                              .price
                                strong $#{(product.precio).toFixed(2)}
                              small.text-muted Stock: #{product.stock}
                            button.btn.btn-primary.w-100.add-to-cart-btn(
                              data-product-id=product._id,
                              data-product-name=product.nombre,
                              data-product-price=product.precio,
                              data-product-image=product.imagen
                            ) Añadir al Carrito

          button.carousel-control-prev(type='button', data-bs-target='#featuredProductsCarousel', data-bs-slide='prev')
            span.carousel-control-prev-icon(aria-hidden='true')
            span.visually-hidden Anterior
          button.carousel-control-next(type='button', data-bs-target='#featuredProductsCarousel', data-bs-slide='next')
            span.carousel-control-next-icon(aria-hidden='true')
            span.visually-hidden Siguiente

        .row.mt-4
          .col-12.text-center
            a.btn.btn-outline-primary.btn-lg(href='/products') Ver Todos los Productos

    // Modal de confirmación
    .modal.fade#add-to-cart-modal(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title Producto añadido al carrito
            button.btn-close(type='button', data-bs-dismiss='modal')
          .modal-body
            p El producto ha sido añadido a tu carrito de compras.
          .modal-footer
            button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Continuar comprando
            a.btn.btn-primary#modal-cart-link(href='/cart') Ver carrito

    // Modal de sugerencia de plan tras speedtest
    .modal.fade#speed-suggestion-modal(tabindex='-1')
      .modal-dialog.modal-dialog-centered.speed-suggestion-dialog
        .modal-content.speed-suggestion-modal
          .modal-header.border-0
            .suggestion-modal-heading
              span.suggestion-kicker Resultado de tu prueba
              h5.modal-title Sugerencia de plan de Internet
            button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Cerrar')
          .modal-body
            .suggestion-hero
              .suggestion-orb
                span.suggestion-orb-ring
                span.suggestion-orb-core
                span.suggestion-orb-icon
                  i.fas.fa-wifi
              .suggestion-hero-copy
                p#suggestion-text.suggestion-text.mb-2
                .suggestion-speed-pill
                  span Velocidad detectada
                  strong#measured-speed-chip -- Mbps
            .suggestion-grid
              .suggestion-panel.suggestion-panel-primary
                span.suggestion-label Plan recomendado
                p.mb-0#suggested-plan
              .suggestion-panel
                span.suggestion-label Producto recomendado
                p.mb-0#suggested-product
              .suggestion-panel
                span.suggestion-label Servicio adicional recomendado
                p.mb-0#suggested-service
          .modal-footer.border-0
            a.btn.btn-primary#suggestion-contact(href='/contacto') Contactar asesor
            button.btn.btn-outline-secondary(type='button', data-bs-dismiss='modal') Seguir explorando

  // Call to Action
  .cta-section.py-5
    .container.text-center
      h3.mb-3 ¿Necesitas asesoramiento?
      p.lead Te ayudaremos a elegir el plan perfecto para ti
      a.btn.btn-success.btn-lg(href='/contacto') Solicitar Asesoría
      a.btn.btn-outline-success.btn-lg.ms-3(href='/cart') Ver Carrito

  script(src='/javascripts/speedtest.js')
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const startButton = document.getElementById('start-speed-test');
      const downloadSpeed = document.getElementById('download-speed');
      const uploadSpeed = document.getElementById('upload-speed');
      const ping = document.getElementById('ping');
      const downloadBar = document.getElementById('download-progress-bar');
      const uploadBar = document.getElementById('upload-progress-bar');
      const pingBar = document.getElementById('ping-progress-bar');

      const speedTestCard = document.getElementById('speed-test-card');
      const suggestionModal = new bootstrap.Modal(document.getElementById('speed-suggestion-modal'));
      const suggestionText = document.getElementById('suggestion-text');
      const suggestedPlan = document.getElementById('suggested-plan');
      const suggestedProduct = document.getElementById('suggested-product');
      const suggestedService = document.getElementById('suggested-service');
      const additionalContact = document.getElementById('suggestion-contact');
      const measuredSpeedChip = document.getElementById('measured-speed-chip');

      const mainInternetPlans = !{JSON.stringify(mainInternetPlans || [])};
      const mainPhonePlans = !{JSON.stringify(mainPhonePlans || [])};
      const mainMobilePlans = !{JSON.stringify(mainMobilePlans || [])};
      const mainChannels = !{JSON.stringify(mainChannels || [])};
      const featuredProductsData = !{JSON.stringify(featuredProducts || [])};

      function parseSpeedPlan(plan) {
        if (!plan) return 0;
        const lower = plan.toLowerCase();
        if (lower.includes('gbps')) {
          return parseFloat(lower) * 1000;
        }
        return parseFloat(plan) || 0;
      }

      function getRecommendedInternet(measured) {
        const sortedPlans = mainInternetPlans.slice().sort((a, b) => parseSpeedPlan(a) - parseSpeedPlan(b));
        const higherPlan = sortedPlans.find(plan => parseSpeedPlan(plan) > measured);
        return higherPlan || sortedPlans[sortedPlans.length - 1] || 'Contacta para más opciones';
      }

      function getAdditionalService() {
        if (mainPhonePlans && mainPhonePlans.length > 0) {
          return `Telefonía: ${mainPhonePlans[0]}`;
        }
        if (mainMobilePlans && mainMobilePlans.length > 0) {
          return `Planes celulares: ${mainMobilePlans[0]}`;
        }
        if (mainChannels && mainChannels.length > 0) {
          return `TV: ${mainChannels[0]}`;
        }
        return 'Consulta nuestros servicios disponibles';
      }

      function getRecommendedProduct() {
        if (featuredProductsData && featuredProductsData.length > 0) {
          const product = featuredProductsData[0];
          return `${product.nombre} - ${product.descripcion}`;
        }
        return 'Revisa nuestros productos destacados en la sección de productos';
      }

      function formatSpeedDisplay(value) {
        const numericValue = parseFloat(value);
        if (!Number.isFinite(numericValue)) return '--';
        const sign = numericValue < 0 ? '-' : '';
        const absoluteValue = Math.abs(numericValue);

        if (absoluteValue >= 100) {
          return sign + Math.trunc(absoluteValue).toString().slice(0, 3);
        }

        if (absoluteValue >= 10) {
          return sign + absoluteValue.toFixed(1).replace(/\.0$/, '');
        }

        return sign + absoluteValue.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
      }

      function showSpeedSuggestion(measuredDownload) {
        const plan = getRecommendedInternet(measuredDownload);
        const formattedMeasuredDownload = formatSpeedDisplay(measuredDownload);
        suggestionText.textContent = `Basado en tu velocidad medida de ${formattedMeasuredDownload} Mbps, te recomendamos un plan superior.`;
        measuredSpeedChip.textContent = `${formattedMeasuredDownload} Mbps`;
        suggestedPlan.textContent = plan;
        suggestedProduct.textContent = getRecommendedProduct();
        suggestedService.textContent = getAdditionalService();
        additionalContact.href = '/contacto';
        suggestionModal.show();
      }

      let st = null;

      startButton.addEventListener('click', function() {
        // Si el test ya corre, lo detiene
        if (st && st.getState() === 3) {
          st.abort();
          startButton.textContent = 'Iniciar Prueba de Velocidad';
          startButton.disabled = false;
          speedTestCard.classList.remove('glow-green');
          speedTestCard.classList.add('glow-cyan');
          return;
        }

        // Resetear UI
        downloadSpeed.textContent = '--';
        uploadSpeed.textContent = '--';
        ping.textContent = '--';
        downloadBar.style.width = '0%';
        uploadBar.style.width = '0%';
        pingBar.style.width = '0%';
        speedTestCard.classList.add('glow-green');
        speedTestCard.classList.remove('glow-cyan');
        startButton.textContent = 'Detener';

        st = new Speedtest();
        st.setParameter('url_dl',    '/backend/garbage');
        st.setParameter('url_ul',    '/backend/empty');
        st.setParameter('url_ping',  '/backend/empty');
        st.setParameter('url_getIp', '/backend/getIP');
        st.setParameter('time_dl_max', 10);
        st.setParameter('time_ul_max', 10);
        st.setParameter('getIp_ispInfo', false);

        st.onupdate = function(data) {
          if (data.dlStatus) {
            downloadSpeed.textContent = formatSpeedDisplay(data.dlStatus);
            downloadBar.style.width = (data.dlProgress * 100).toFixed(0) + '%';
          }
          if (data.ulStatus) {
            uploadSpeed.textContent = formatSpeedDisplay(data.ulStatus);
            uploadBar.style.width = (data.ulProgress * 100).toFixed(0) + '%';
          }
          if (data.pingStatus) {
            ping.textContent = parseFloat(data.pingStatus).toFixed(2);
            pingBar.style.width = Math.min(data.pingProgress * 100, 100).toFixed(0) + '%';
          }
        };

        st.onend = function(aborted) {
          startButton.disabled = false;
          startButton.textContent = 'Iniciar Prueba de Velocidad';
          speedTestCard.classList.remove('glow-green');
          speedTestCard.classList.add('glow-cyan');
          if (!aborted && downloadSpeed.textContent !== '--') {
            showSpeedSuggestion(parseFloat(downloadSpeed.textContent));
          }
        };

        st.start();
      });

      // Código para añadir al carrito (si hay productos destacados)
      const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
      if (addToCartButtons.length > 0) {
        const modal = new bootstrap.Modal(document.getElementById('add-to-cart-modal'));
        const modalCartLink = document.getElementById('modal-cart-link');

        addToCartButtons.forEach(button => {
          button.addEventListener('click', function() {
            const productId = this.getAttribute('data-product-id');

            fetch('/cart/add', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                productId: productId,
                cantidad: 1
              })
            })
            .then(response => response.json())
            .then(data => {
              if (data._id) {
                modal.show();
              } else {
                alert('Error al añadir al carrito: ' + (data.message || 'Error desconocido'));
              }
            })
            .catch(error => {
              console.error('Error:', error);
              alert('Error de conexión');
            });
          });
        });
      }
    });
