extends layout

block content
  .container.py-5
    h1.mb-4 #{title}
    p.lead Conoce nuestra propuesta y cómo trabajamos para conectar tu mundo.
    .row.g-4
      .col-md-6
        .card.shadow-sm
          .card-body
            h3 Misión
            p #{mission}
      .col-md-6
        .card.shadow-sm
          .card-body
            h3 Visión
            p #{vision}
    .mt-4
      .card.shadow-sm
        .card-body
          h3 Nuestros valores
          ul
            each value in values
              li #{value}
    .mt-4
      .card.shadow-sm
        .card-body
          h3 Sobre nosotros
          p Somos un proveedor de internet comprometido con conexiones estables, planes claros y atención cercana para cada cliente.
