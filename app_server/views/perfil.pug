extends layout

block content
  .container.py-5
    .row
      .col-lg-6.mx-auto
        h2.mb-4
          i.fas.fa-user-edit.me-2(style='color:var(--c-cyan)')
          | Mi Perfil

        if error
          .alert.mb-3(style='background:rgba(244,145,191,0.12);border:1px solid rgba(244,145,191,0.4);color:#F491BF;border-radius:.75rem')
            i.fas.fa-exclamation-circle.me-2
            = error

        if success
          .alert.mb-3(style='background:rgba(113,228,244,0.12);border:1px solid rgba(113,228,244,0.4);color:#71E4F4;border-radius:.75rem')
            i.fas.fa-check-circle.me-2
            = success

        .card(style='border:1px solid rgba(113,228,244,0.2)')
          .card-header(style='background:rgba(113,228,244,0.06)')
            .d-flex.align-items-center
              i.fas.fa-user-circle.me-2.fa-2x(style='color:var(--c-cyan)')
              div
                h5.mb-0= user.username
                small.text-muted
                  if user.role === 'admin'
                    span.badge(style='background:linear-gradient(90deg,#D374FF,#F491BF);color:#0d0d14;border-radius:50px;font-size:.7rem')
                      i.fas.fa-shield-alt.me-1
                      | ADMIN
                  else if user.role === 'guest'
                    span.badge(style='background:rgba(255,255,255,0.1);color:#a0a0b8;border-radius:50px;font-size:.7rem') Invitado
                  else
                    span.badge(style='background:rgba(113,228,244,0.2);color:var(--c-cyan);border-radius:50px;font-size:.7rem') Usuario

          .card-body
            if user.role === 'guest'
              .alert(style='background:rgba(244,145,191,0.1);border:1px solid rgba(244,145,191,0.3);color:#F491BF;border-radius:.75rem')
                i.fas.fa-info-circle.me-2
                | Estás como invitado.&nbsp;
                a(href='/register' style='color:#F491BF') Crea una cuenta
                |  para guardar tu perfil.
            else
              form(action='/perfil' method='POST')
                .mb-3
                  label.form-label Cambiar nombre de usuario
                  input.form-control(
                    type='text'
                    name='username'
                    value=user.username
                    placeholder='nuevo_usuario'
                    autocomplete='username'
                  )
                hr(style='border-color:rgba(255,255,255,0.08)')
                h6.mb-3(style='color:#a0a0b8') Cambiar contraseña (opcional)
                .mb-3
                  label.form-label Contraseña actual
                  input.form-control(
                    type='password'
                    name='currentPassword'
                    placeholder='••••••••'
                    autocomplete='current-password'
                  )
                .mb-3
                  label.form-label Nueva contraseña
                  input.form-control(
                    type='password'
                    name='newPassword'
                    placeholder='••••••••'
                    autocomplete='new-password'
                  )
                .d-grid.mt-4
                  button.btn.btn-primary(type='submit')
                    i.fas.fa-save.me-2
                    | Guardar Cambios
