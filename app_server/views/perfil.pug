extends layout

block content
  .py-5
    h1.mb-4 #{title}
    p.lead Revisa y actualiza tu información de cliente.
    if user
      .card.mb-4
        .card-body
          h2.mb-3 Datos del cliente
          dl.row
            dt.col-sm-3 Nombre
            dd.col-sm-9 #{user.nombre} #{user.apellido}
            dt.col-sm-3 Identificación
            dd.col-sm-9 #{user.identificacion}
            dt.col-sm-3 Teléfono
            dd.col-sm-9 #{user.telefono}
            dt.col-sm-3 Correo
            dd.col-sm-9 #{user.email || 'No registrado'}
            dt.col-sm-3 Dirección
            dd.col-sm-9 #{user.direccion || 'No especificada'}
          if user && user._id
            a.btn.btn-warning.mt-3(href='/users/edit/'+user._id) Editar cliente
      .row.g-4
        .col-md-4
          .card.shadow-sm.h-100
            .card-body
              h3 Planes de internet
              if user.services && user.services.internetPlans.length
                ul.mb-0
                  each plan in user.services.internetPlans
                    li= plan
              else
                p.text-muted No hay planes seleccionados.
        .col-md-4
          .card.shadow-sm.h-100
            .card-body
              h3 Telefonía fija
              if user.services && user.services.phonePlans.length
                ul.mb-0
                  each plan in user.services.phonePlans
                    li= plan
              else
                p.text-muted No hay planes seleccionados.
        .col-md-4
          .card.shadow-sm.h-100
            .card-body
              h3 Plan celular
              if user.services && user.services.mobilePlans.length
                ul.mb-0
                  each plan in user.services.mobilePlans
                    li= plan
              else
                p.text-muted No hay planes seleccionados.
      .card.mt-4
        .card-body
          h3 Canales internacionales
          if user.services && user.services.internationalChannels.length
            ul.mb-0
              each channel in user.services.internationalChannels
                li= channel
          else
            p.text-muted No hay canales seleccionados.
    else
      p.text-danger No se encontró información de usuario.
