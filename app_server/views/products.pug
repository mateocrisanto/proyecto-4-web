extends layout

block content
  .container.py-5
    .row
      .col-12
        h1.display-4.text-center.mb-5 #{title}
        p.lead.text-center.mb-5 Explora nuestros productos tecnológicos de alta calidad
    #products-react-root
    script(type='application/json' id='products-initial-data').
      !{JSON.stringify({ products: products || [] }).replace(/<\//g, '<\\/')}

block scripts
  script(src='https://unpkg.com/react@18/umd/react.production.min.js')
  script(src='https://unpkg.com/react-dom@18/umd/react-dom.production.min.js')
  script(type='module' src='/javascripts/react-products.js')
