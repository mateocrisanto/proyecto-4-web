extends auth_layout

block content
  h4.text-center.mb-1.text-white Crear Cuenta
  p.text-center.mb-4(style='color:#a0a0b8;font-size:.9rem') Solo necesitas usuario y contraseña

  if error
    .alert.mb-3(style='background:rgba(244,145,191,0.12);border:1px solid rgba(244,145,191,0.4);color:#F491BF;border-radius:.75rem')
      i.fas.fa-exclamation-circle.me-2
      = error

  if success
    .alert.mb-3(style='background:rgba(113,228,244,0.12);border:1px solid rgba(113,228,244,0.4);color:#71E4F4;border-radius:.75rem')
      i.fas.fa-check-circle.me-2
      = success
      br
      a.mt-2.d-inline-block(href='/login' style='color:#71E4F4;font-weight:600') Ir al login →

  if !success
    form(action='/register' method='POST')
      .mb-3
        label.form-label(for='username' style='color:#a0a0b8;font-size:.85rem') Usuario
        input#username.form-control(
          type='text'
          name='username'
          placeholder='mi_usuario'
          autocomplete='username'
          required
        )
      .mb-3
        label.form-label(for='password' style='color:#a0a0b8;font-size:.85rem') Contraseña
        input#password.form-control(
          type='password'
          name='password'
          placeholder='••••••••'
          autocomplete='new-password'
          required
        )
      .mb-4
        label.form-label(for='confirmPassword' style='color:#a0a0b8;font-size:.85rem') Confirmar Contraseña
        input#confirmPassword.form-control(
          type='password'
          name='confirmPassword'
          placeholder='••••••••'
          autocomplete='new-password'
          required
        )
      button.btn.btn-primary.w-100(type='submit')
        i.fas.fa-user-plus.me-2
        | Crear Cuenta

  .text-center.mt-4
    span(style='color:#a0a0b8;font-size:.875rem') ¿Ya tienes cuenta?&nbsp;
    a(href='/login' style='color:#71E4F4') Inicia sesión aquí
