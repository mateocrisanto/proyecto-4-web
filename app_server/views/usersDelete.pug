extends layout

block content
  main.container.py-5
    h1.mb-4 #{title}
    p.lead #{message}
    .card.shadow-sm
      .card-body
        h2.mb-3 Datos del cliente a eliminar
        .row.g-3.mb-4
          .col-md-6
            label.form-label Nombre
            input.form-control(type='text', value=nombre, readonly, disabled)
          .col-md-6
            label.form-label Apellido
            input.form-control(type='text', value=apellido, readonly, disabled)
          .col-md-6
            label.form-label Identificación
            input.form-control(type='number', value=identificacion, readonly, disabled)
          .col-md-6
            label.form-label Teléfono
            input.form-control(type='tel', value=telefono, readonly, disabled)
          .col-md-12
            label.form-label Correo
            input.form-control(type='email', value=email, readonly, disabled)
          .col-md-12
            label.form-label Dirección
            input.form-control(type='text', value=direccion, readonly, disabled)

        .alert.alert-warning ¿Está seguro de que desea eliminar este cliente?

        form(action='', method='post')
          button.btn.btn-danger(type='submit') Confirmar eliminación
          a.btn.btn-secondary.ms-2(href='/users') Cancelar

  footer.footer.mt-auto.py-3.bg-light.fixed-bottom
    .container
      span.text-muted #{message}
